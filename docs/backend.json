{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user within the application, storing their profile information and assigned role for access control.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name, typically obtained from the authentication provider."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The assigned role of the user (e.g., Admin, Editor, Viewer), dictating their permissions.",
          "enum": ["Admin", "Editor", "Viewer"]
        },
        "team": {
          "type": "string",
          "description": "The discipline or team the user belongs to within the agency."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "displayName",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Quadrant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quadrant",
      "type": "object",
      "description": "Defines a customizable category or axis on the Tech Radar.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "order", "createdAt"]
    },
    "Ring": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Ring",
      "type": "object",
      "description": "Defines a customizable adoption stage or concentric ring on the Tech Radar.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "order", "color", "createdAt"]
    },
    "Tag": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tag",
      "type": "object",
      "description": "Represents a keyword used to label Radar Items.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "RadarItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RadarItem",
      "type": "object",
      "description": "Represents a single tool or technique on the Tech Radar.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortDescription": { "type": "string" },
        "quadrantId": { "type": "string" },
        "ringId": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "name", "shortDescription", "quadrantId", "ringId", "ownerId", "status", "createdAt", "createdBy"]
    },
    "Experience": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Experience",
      "type": "object",
      "description": "Represents a user's strategic experience with specific radar items.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "toolLinks": { "type": "array", "items": { "type": "string" } },
        "howUsed": { "type": "string" },
        "findings": { "type": "string" },
        "status": { "type": "string", "enum": ["Published", "Hidden"] },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "summary", "toolLinks", "howUsed", "findings", "status", "createdAt", "createdBy"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores individual user profiles."
        }
      },
      {
        "path": "/radarItems/{radarItemId}",
        "definition": {
          "entityName": "RadarItem",
          "schema": { "$ref": "#/backend/entities/RadarItem" },
          "description": "Stores individual radar items."
        }
      },
      {
        "path": "/experiences/{experienceId}",
        "definition": {
          "entityName": "Experience",
          "schema": { "$ref": "#/backend/entities/Experience" },
          "description": "Stores strategic experiences shared by users."
        }
      }
    ]
  }
}