
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      // Safely check for profile existence to avoid rule evaluation errors
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data.role : 'Viewer';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'Admin';
    }

    match /userProfiles/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /quadrants/{quadrantId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rings/{ringId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /radarItems/{radarItemId} {
      allow get: if isSignedIn() && (resource.data.status != 'Draft' || resource.data.createdBy == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /itemComments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(resource.data.createdBy) || isAdmin();
      }

      match /itemHistory/{historyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /experiences/{experienceId} {
      // Use explicit get/list for better QAP satisfaction
      allow get: if isSignedIn() && (resource.data.status == 'Published' || resource.data.createdBy == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (request.query.limit <= 100);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();
    }
  }
}
