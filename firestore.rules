rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EXPERIENCES PLATFORM SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a flexible, user-ownership model designed for rapid prototyping.
     * It prioritizes strict authorization (who can do what) over rigid schema validation.
     * 
     * DATA STRUCTURE:
     * - /experiences/{experienceId}: Top-level collection for user-logged experiences.
     * - /experiences/{experienceId}/comments/{commentId}: Sub-collection for discussion.
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: All critical authorization data (createdBy, status) is 
     *    denormalized onto the documents to avoid expensive and slow get() calls.
     * 2. Visibility Control: Read access is restricted to 'Published' content for general users,
     *    while owners and admins can see 'Hidden' content.
     * 3. Admin Oversight: A global admin check allows designated users to moderate content 
     *    (status: 'Hidden') or delete problematic entries.
     * 4. Immutable Ownership: The 'createdBy' field is enforced on creation and made 
     *    immutable during updates to prevent identity spoofing.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /** 
     * Checks if the user has an Admin record. 
     * Based on IR reasoning for global roles stored in /roles_admin/{uid}.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Combines ownership check with existence check for updates/deletes. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** Checks if a document has a 'Published' status. */
    function isPublished(data) {
      return data.status == 'Published';
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the top-level Experiences collection.
     * @path /experiences/{experienceId}
     * @allow (get) If signed in and (status is Published OR user is owner OR user is admin).
     * @allow (create) If signed in and data.createdBy matches auth.uid.
     * @allow (update/delete) If user is the original creator or an admin.
     * @deny (write) If trying to change the 'createdBy' field or if not authenticated.
     * @principle Enforces document ownership and visibility-based reads.
     */
    match /experiences/{experienceId} {
      allow get: if isSignedIn() && (isPublished(resource.data) || isOwner(resource.data.createdBy) || isAdmin());
      allow list: if isSignedIn(); // Filtering is handled by the query (QAP), rule validates per-doc on result set.
      
      allow create: if isSignedIn() 
                    && request.resource.data.createdBy == request.auth.uid;
      
      allow update: if isSignedIn() 
                    && (isExistingOwner(resource.data.createdBy) || isAdmin())
                    && request.resource.data.createdBy == resource.data.createdBy; // Enforce immutable ownership
      
      allow delete: if isSignedIn() 
                    && (isExistingOwner(resource.data.createdBy) || isAdmin());

      /**
       * @description Rules for comments nested under specific experiences.
       * @path /experiences/{experienceId}/comments/{commentId}
       * @allow (get/list) If signed in (implicitly limited by parent experience visibility in the UI).
       * @allow (create) If signed in and fields 'createdBy' and 'experienceId' are correctly set.
       * @allow (update/delete) If user is the original creator of the comment or an admin.
       * @principle Authorization independence: comment access doesn't require fetching the parent experience.
       */
      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        
        allow create: if isSignedIn() 
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.experienceId == experienceId;
        
        allow update: if isSignedIn() 
                      && (isExistingOwner(resource.data.createdBy) || isAdmin())
                      && request.resource.data.createdBy == resource.data.createdBy;
        
        allow delete: if isSignedIn() 
                      && (isExistingOwner(resource.data.createdBy) || isAdmin());
      }
    }

    /**
     * @description Placeholder for Admin role assignments.
     * @path /roles_admin/{userId}
     * @principle Admins are defined in a dedicated collection. Access to this collection should be restricted to a Root Admin or via Cloud Functions.
     */
    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Security: Admin roles should not be self-assigned or client-writable.
    }
  }
}