rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly enforce that Google users must have a greenberry.nl email.
    // Anonymous users are allowed as 'Guests'.
    function isGreenberryUser() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@greenberry\\.nl$')) || 
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data.role : 'Viewer';
    }

    function isAdmin() {
      return isGreenberryUser() && getUserRole() == 'Admin';
    }

    match /userProfiles/{userId} {
      allow read: if isGreenberryUser();
      allow list: if isGreenberryUser();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /quadrants/{quadrantId} {
      allow read: if isGreenberryUser();
      allow write: if isAdmin();
    }

    match /rings/{ringId} {
      allow read: if isGreenberryUser();
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if isGreenberryUser();
      allow write: if isAdmin();
    }

    match /radarItems/{radarItemId} {
      allow read: if isGreenberryUser();
      allow create: if isGreenberryUser();
      allow update: if isGreenberryUser() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /itemComments/{commentId} {
        allow read: if isGreenberryUser();
        allow create: if isGreenberryUser();
        allow update, delete: if isOwner(resource.data.createdBy) || isAdmin();
      }

      match /itemHistory/{historyId} {
        allow read: if isGreenberryUser();
        allow create: if isGreenberryUser();
        allow update, delete: if isAdmin();
      }
    }

    match /experiences/{experienceId} {
      allow read: if isGreenberryUser();
      allow create: if isGreenberryUser();
      allow update: if isGreenberryUser() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isGreenberryUser() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
  }
}